generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Perfume {
  id        Int      @id @default(autoincrement())
  name      String
  perfume_code String @unique
  description String?
  price     Float
  category  Category @relation(fields: [category_id], references: [id])
  category_id Int
  analogs     Analog[]   @relation("PerfumeAnalog") // Связь с аналогами
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String  @unique
  perfumes Perfume[]
}

model Analog{
  id      Int      @id @default(autoincrement())
  name    String  @unique
  perfumes Perfume[] @relation("PerfumeAnalog") // Связь с парфюмами
}