generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Perfume {
  id        Int      @id @default(autoincrement())
  name      String
  perfume_id String
  description String?
  price     Float
  brand     Brand     @relation(fields: [brand_id], references: [id])
  brand_id   Int
  category  Category @relation(fields: [category_id], references: [id])
  category_id Int
  analogs   Analog[]
}

model Analog {
  id Int      @id @default(autoincrement())
  name String
  perfume     Perfume       @relation(fields: [perfume_id], references: [id])
  perfume_id   Int
}

model Brand {
  id      Int      @id @default(autoincrement())
  name    String
  perfumes Perfume[]
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String
  perfumes Perfume[]
}