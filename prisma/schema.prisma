generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id         Int     @id @default(autoincrement())
  image_path String  @unique
  perfume    Perfume @relation(fields: [perfume_id], references: [id])
  perfume_id Int
}

model Perfume {
  id                  Int               @id @default(autoincrement())
  name                String
  perfume_code        String            @unique
  description         String?
  analog              String            @unique
  custom_price_per_ml Float
  price_30ml          Float?
  price_50ml          Float?
  top_note            String
  middle_note         String
  base_note           String
  images              Image[]
  CategoryPerfume     CategoryPerfume[]
  reviews Review[]
  order_items         OrderItem[]
}

model Category {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  CategoryPerfume CategoryPerfume[]
}

model CategoryPerfume {
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int
  perfume     Perfume  @relation(fields: [perfume_id], references: [id])
  perfume_id  Int

  @@id([category_id, perfume_id])
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(20)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  is_admin   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  reviews Review[]
  orders     Order[]
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id     Int
  perfume_id  Int
  text       String
  rating     Int
  created_at  DateTime @default(now())

  // Связи с другими моделями (если они есть)
  user       User     @relation(fields: [user_id], references: [id])
  perfume    Perfume  @relation(fields: [perfume_id], references: [id])
}

model Order {
  id                 Int           @id @default(autoincrement())
  address            String        
  city               String
  country            String        @db.VarChar(3) @default("SAU")
  phone              String
  latitude           Decimal?      // Широта
  longitude          Decimal?      // Долгота
  delivery_price     Decimal       
  order_price        Decimal
  tracking_number    String?
  delivery_method    String?
  expected_delivery  DateTime?
  notes              String?       
  status             OrderStatus   @default(pending)
  user_id            Int
  user               User          @relation(fields: [user_id], references: [id])
  items              OrderItem[]
  status_history      OrderStatusHistory[]
  payments           Payment[]
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  @@unique([id, user_id])
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  volume_in_ml      Int
  quantity    Int
  price       Decimal
  discount    Int       @default(0)
  total_price Decimal
  order_id     Int
  perfume_id   Int
  perfume     Perfume   @relation(fields: [perfume_id], references: [id])
  order       Order     @relation(fields: [order_id], references: [id])
}

enum PaymentStatus {
  unpaid
  paid
  refunded
  partially_refunded
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  returned
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  order_id   Int
  status    OrderStatus
  comment   String?
  created_at DateTime    @default(now())
  order     Order       @relation(fields: [order_id], references: [id])
}

model Payment {
  id        Int       @id @default(autoincrement())
  order_id   Int
  amount    Decimal
  method    String
  status    PaymentStatus
  paid_at   DateTime?
  order     Order     @relation(fields: [order_id], references: [id])
  created_at DateTime  @default(now())
}
